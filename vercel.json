{
  "rewrites": [
    {
      "source": "/api/payment/:path*",
      "destination": "https://cs-490-group-backend.vercel.app/payment/:path*"
    },
    {
      "source": "/api/invoice/:path*",
      "destination": "https://cs-490-group-backend.vercel.app/invoice/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cs-490-group-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}